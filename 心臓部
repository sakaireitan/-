<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>行動記録アプリ</title>
    
    <!-- PWA用の設定を追加 -->
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#3498db">
    <link rel="apple-touch-icon" href="icon-192.png">

    <style>
        * { box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background-color: #f4f7f6; margin: 0; padding: 15px; color: #333; max-width: 500px; margin: 0 auto; }
        .form-container { background: #ffffff; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .form-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .form-header h2 { margin: 0; font-size: 18px; color: #2c3e50; }
        .today-display { font-size: 13px; color: #7f8c8d; margin-bottom: 15px; font-weight: bold; }
        .clear-btn { background: none; border: none; color: #e74c3c; font-size: 12px; cursor: pointer; text-decoration: underline; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; font-size: 13px; color: #555; }
        .time-inputs { display: flex; align-items: center; gap: 10px; }
        input[type="time"], input[type="text"] { width: 100%; padding: 12px; border: 1px solid #ddd; border-radius: 8px; font-size: 16px; background-color: #fafafa; }
        button.submit-btn { width: 100%; padding: 14px; background-color: #3498db; color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; touch-action: manipulation; }
        button.submit-btn:active { background-color: #2980b9; }
        .schedule-container { background: #ffffff; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); overflow: hidden; margin-bottom: 30px; }
        .hour-block { display: flex; border-bottom: 1px solid #f0f0f0; min-height: 52px; }
        .hour-block:last-child { border-bottom: none; }
        .time-label { width: 55px; padding: 10px 5px; font-size: 12px; color: #7f8c8d; background-color: #f9fbfb; border-right: 1px solid #f0f0f0; text-align: right; font-weight: bold; }
        .task-area { flex-grow: 1; padding: 6px 10px; display: flex; flex-direction: column; gap: 6px; justify-content: center; }
        .task-item { padding: 8px 10px; border-radius: 6px; font-size: 13px; display: flex; justify-content: space-between; align-items: center; word-break: break-all; border-left-width: 4px; border-left-style: solid; }
        .delete-btn { cursor: pointer; font-weight: bold; padding: 2px 6px; margin-left: 5px; opacity: 0.7; }
    </style>
</head>
<body>

    <div class="form-container">
        <div class="form-header">
            <h2>行動を記録</h2>
            <button class="clear-btn" onclick="clearAllData()">全消去</button>
        </div>
        <div class="today-display" id="todayDisplay"></div>
        
        <div class="form-group">
            <label>時間（開始 〜 終了）</label>
            <div class="time-inputs">
                <input type="time" id="startTime" required>
                <span>〜</span>
                <input type="time" id="endTime" required>
            </div>
        </div>

        <div class="form-group">
            <label>内容</label>
            <input type="text" id="taskDesc" placeholder="例：読書、散歩など" required>
        </div>

        <button class="submit-btn" onclick="addRecord()">記録する</button>
    </div>

    <div class="schedule-container" id="schedule"></div>

    <script>
        const STORAGE_KEY = 'my_action_logger_records_v3';

        window.addEventListener('DOMContentLoaded', () => {
            showToday();
            createScheduleGrid();
            loadRecords();
            setDefaultTime();
        });

        function getFormattedDate(date = new Date()) {
            const year = date.getFullYear();
            const month = date.getMonth() + 1;
            const day = date.getDate();
            return `${year}年${month}月${day}日`;
        }

        function showToday() {
            document.getElementById('todayDisplay').innerText = `日付：${getFormattedDate()}`;
        }

        function createScheduleGrid() {
            const container = document.getElementById('schedule');
            container.innerHTML = '';
            for (let i = 0; i < 24; i++) {
                const hourBlock = document.createElement('div');
                hourBlock.className = 'hour-block';
                hourBlock.innerHTML = `
                    <div class="time-label">${i}:00</div>
                    <div class="task-area" id="hour-${i}"></div>
                `;
                container.appendChild(hourBlock);
            }
        }

        function setDefaultTime() {
            const now = new Date();
            const hours = String(now.getHours()).padStart(2, '0');
            const minutes = String(now.getMinutes()).padStart(2, '0');
            document.getElementById('startTime').value = `${hours}:${minutes}`;
        }

        function getTaskColors(str) {
            let hash = 0;
            for (let i = 0; i < str.length; i++) {
                hash = str.charCodeAt(i) + ((hash << 5) - hash);
            }
            const hue = Math.abs(hash) % 360;
            return {
                bg: `hsl(${hue}, 85%, 92%)`,
                text: `hsl(${hue}, 70%, 30%)`,
                border: `hsl(${hue}, 70%, 55%)`
            };
        }

        function loadRecords() {
            const saved = localStorage.getItem(STORAGE_KEY);
            const records = saved ? JSON.parse(saved) : [];
            
            for (let i = 0; i < 24; i++) {
                document.getElementById(`hour-${i}`).innerHTML = '';
            }

            records.forEach((record, index) => {
                const startHour = parseInt(record.startTime.split(':')[0], 10);
                const targetArea = document.getElementById(`hour-${startHour}`);
                if (targetArea) {
                    const colors = getTaskColors(record.taskDesc);
                    const item = document.createElement('div');
                    item.className = 'task-item';
                    item.style.backgroundColor = colors.bg;
                    item.style.color = colors.text;
                    item.style.borderLeftColor = colors.border;
                    item.innerHTML = `
                        <span><strong>${record.startTime}〜${record.endTime}</strong> <span style="font-size:11px; opacity:0.8;">[${record.date}]</span> ${escapeHtml(record.taskDesc)}</span>
                        <span class="delete-btn" style="color: ${colors.text};" onclick="deleteRecord(${index})">✕</span>
                    `;
                    targetArea.appendChild(item);
                }
            });
        }

        function addRecord() {
            const startTime = document.getElementById('startTime').value;
            const endTime = document.getElementById('endTime').value;
            const taskDesc = document.getElementById('taskDesc').value.trim();

            if (!startTime || !endTime || !taskDesc) {
                alert('すべての項目を入力してください。');
                return;
            }

            const dateStr = getFormattedDate();
            const saved = localStorage.getItem(STORAGE_KEY);
            const records = saved ? JSON.parse(saved) : [];

            records.push({ date: dateStr, startTime, endTime, taskDesc });
            localStorage.setItem(STORAGE_KEY, JSON.stringify(records));

            document.getElementById('startTime').value = endTime;
            document.getElementById('endTime').value = '';
            document.getElementById('taskDesc').value = '';

            loadRecords();
        }

        function deleteRecord(index) {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (!saved) return;
            let records = JSON.parse(saved);
            records.splice(index, 1);
            localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
            loadRecords();
        }

        function clearAllData() {
            if (confirm('すべての記録を消去しますか？')) {
                localStorage.removeItem(STORAGE_KEY);
                loadRecords();
            }
        }

        function escapeHtml(str) {
            return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        // --- ここからPWA用のサービスワーカー登録処理 ---
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('sw.js')
                .then(registration => {
                    console.log('ServiceWorker 登録成功', registration.scope);
                })
                .catch(err => {
                    console.log('ServiceWorker 登録失敗', err);
                });
            });
        }
    </script>
</body>
</html>
